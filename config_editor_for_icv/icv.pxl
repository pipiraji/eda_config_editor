/*
 * =========================================================================
 *  Synopsys IC Validator (ICV) - PXL Runset Configuration Header
 *  Description: #define 지시자를 이용한 공정 상수 및 실행 스위치 정의 예시
 * =========================================================================
 */

// -------------------------------------------------------------------------
// 1. 글로벌 실행 제어 스위치 (Global Execution Switches)
//    - 값 없이 정의되어, 아래에서 #ifdef 조건문 제어용으로 사용됩니다.
// -------------------------------------------------------------------------

#define RUN_DRC_CORE           // [활성화] 기본 기하학적 DRC 검사를 실행합니다.
#define RUN_DFM_DUMMY          // [활성화] 메탈 dummy fill(더미 채우기) 룰을 활성화합니다.

// [비활성화] 아래 변수들은 주석 처리되어 이번 검사에서 실행되지 않습니다.
// #define RUN_LVS_CHECK
// #define RUN_ANTENNA_CHECK
// #define ESD_RULE_OPTION_2


// -------------------------------------------------------------------------
// 2. 공정 테크놀로지 옵션 (Technology Options)
//    - 특정 공정 세대나 트랜지스터 구조를 선택하는 다중 변수입니다.
// -------------------------------------------------------------------------

#define PROCESS_NODE_3NM       // 3나노 공정 룰셋 적용
#define ENABLE_FINFET_RULES    // FinFET 구조에 특화된 검사 규칙 활성화

/* 
 * 차세대 GAA(Gate-All-Around) 공정 옵션은 
 * 현재 프로젝트에서 사용하지 않으므로 블록 주석으로 비활성화합니다.
 #define ENABLE_GAA_RULES
 #define GAA_STACK_COUNT 3
 */


// -------------------------------------------------------------------------
// 3. 물리적 치수 및 디자인 룰 상수 정의 (Physical Constants)
//    - 변수명 뒤에 구체적인 수치(정수/부동소수점)를 대입한 예시입니다.
// -------------------------------------------------------------------------

// 데이터 해상도 설정
#define GRID_RESOLUTION    0.001 // 제조 그리드 크기 (마이크로미터 단위)

// Metal 1 (M1) 레이어 치수 변수 정의
#define M1_MIN_WIDTH       0.028 // M1 최소 폭 (Width)
#define M1_MIN_SPACING     0.032 // M1 최소 간격 (Spacing)
#define M1_MAX_WIDTH       2.500 // M1 최대 광폭 제한

// Metal 2 (M2) 레이어 치수 변수 정의
#define M2_MIN_WIDTH       0.034 // M2 최소 폭
#define M2_MIN_SPACING     0.038 // M2 최소 간격

// Via 1 (V1) 레이어 치수 및 Enclosure 변수 정의
#define VIA1_SIZE          0.030 // Via1 가로/세로 정방형 크기
#define VIA1_ENC_M1        0.005 // M1이 Via1을 사방으로 감싸야 하는 최소 치수
#define VIA1_ENC_M2        0.008 // M2가 Via1을 사방으로 감싸야 하는 최소 치수


// -------------------------------------------------------------------------
// 4. #define 변수를 활용한 조건부 컴파일 문법 적용 예시
//    - 위에서 정의한 변수의 존재 유무에 따라 내부 변수를 추가 정의합니다.
// -------------------------------------------------------------------------

#ifdef ENABLE_FINFET_RULES
    #define FIN_PITCH      0.024 // FinFET 규칙이 켜졌을 때만 피치(Pitch) 변수 정의
    #define FIN_DUMMY_NUM  2     // 외곽 더미 Fin 개수 정의
#endif

#ifndef GRID_RESOLUTION
    #define GRID_RESOLUTION 0.005 // 만약 앞에서 실수로 누락되었다면 기본값으로 지정
#endif